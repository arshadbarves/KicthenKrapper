.loginButton {
    width: 600px;
    height: 125px;
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(99, 168, 255);
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
}

.loginScreen {
    flex-direction: row;
    -unity-font-definition: url("project://database/Assets/RecipeRage/Fonts/Inter-VariableFont_slnt,wght%20SDF.asset?fileID=11400000&guid=20cf61850a9d642658a83d3660c5ca78&type=2#Inter-VariableFont_slnt,wght SDF");
    font-size: 24px;
    color: rgb(66, 66, 66);
    width: 100%;
    height: 100%;
}

.leftPanel {
    flex-grow: 1;
    background-color: rgb(0, 0, 0);
    transition-property: translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
    translate: -100% 0;
}

.rightPanel {
    width: 70%;
    background-color: rgb(255, 255, 255);
    transition-duration: 0.3s;
    transition-property: translate;
    transition-timing-function: ease-in-out;
    translate: 100% 0;
}

.leftPanel--active {
    translate: 0 0;
}

.rightPanel--active {
    translate: 0 0;
}
