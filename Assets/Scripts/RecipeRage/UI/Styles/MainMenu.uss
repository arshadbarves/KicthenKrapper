#navBar > .unity-tab-view__header-container {
    align-self: center;
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    background-color: rgb(0, 0, 0);
    width: 500px;
    height: 115px;
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    justify-content: space-between;
    flex-direction: row;
    align-items: center;
}

#navBar > .unity-tab-view__header-container > .unity-tab__header {
    align-items: center;
    justify-content: center;
    align-self: center;
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.3s;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
}

#navBar > .unity-tab-view__header-container > .unity-tab__header:checked {
    background-color: rgb(246, 86, 86);
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
}

#navBar > .unity-tab-view__header-container > .unity-tab__header > .unity-tab__header-image {
    height: 42px;
    width: 42px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
}

#navBar > .unity-tab-view__header-container > .unity-tab__header > .unity-tab__header-underline {
    display: none;
}

#navBar > .unity-tab-view__content-container {
    height: 100%;
}

.unity-tab__content-container {
    height: 100%;
}

.unity-tab {
    height: 100%;
}

.itemButton {
    background-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    flex-direction: row;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
}

.itemIcon {
    flex-grow: 1;
    background-image: url("project://database/Assets/Third%20Party%20Assets/GUI%20PRO%20Kit%20-%20Simple%20Casual/Sprite/Demo/Demo_Icon/Icon_ColorIcon_Coin_l.png?fileID=2800000&guid=1e0204e4d32684272b7718888c21dd55&type=3#Icon_ColorIcon_Coin_l");
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
}

.itemLabel {
    font-size: 32px;
}

.notificationLabel {
    color: rgb(255, 255, 255);
    align-self: center;
    position: absolute;
    translate: 100px 10px;
    transition-property: scale;
    transition-duration: 0.5s;
    transition-timing-function: linear;
}
